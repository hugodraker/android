<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.dlnaserver"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Permissions required for DLNA, SSDP Multicast, and Media File Access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Android 2.3 Target -->
    <uses-sdk android:minSdkVersion="9" android:targetSdkVersion="10" />

    <application
        android:label="DLNA Server"
        android:icon="@drawable/ic_launcher">
        
        <activity android:name=".DlnaActivity"
                  android:label="DLNA Server Settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".DlnaService" />
    </application>
</manifest>
